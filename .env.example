# Copy to .env.langfuse and fill in. Real values are gitignored.

# Model endpoint (any OpenAI- or Anthropic-compatible base URL)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Local Langfuse (docker compose -f docker-compose.langfuse.yml --env-file .env.langfuse up -d)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
